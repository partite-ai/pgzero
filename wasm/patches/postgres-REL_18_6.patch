+#ifdef __wasi__
+/*
+ * pgzero: in wasm, most of a function's frame lives on the engine's own stack,
+ * which C cannot see; only locals that must be in memory go on the "shadow"
+ * stack that stack_is_too_deep() measures. Recursion through functions that
