+bool
+pg_strong_random(void *buf, size_t len)
+{
+	char	   *p = buf;
+
+	/* getentropy() returns at most 256 bytes per call */
+	while (len > 0)
+	{
+		size_t		chunk = Min(len, 256);
+
+		if (getentropy(p, chunk) != 0)
+			return false;
+		p += chunk;
+		len -= chunk;
+	}
+	return true;
