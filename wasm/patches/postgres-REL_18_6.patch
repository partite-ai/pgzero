diff --git a/src/backend/port/wasm_sema.c b/src/backend/port/wasm_sema.c
new file mode 100644
index 0000000..2b841e1
--- /dev/null
+++ b/src/backend/port/wasm_sema.c
@@ -0,0 +1,104 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_sema.c
+ *	  Semaphores for the pgzero wasm port.
+ *
+ * The pgzero host keeps counting semaphores shared by all processes. A
+ * PGSemaphore in shared memory just records the host's id, so any process
+ * can use it.
+ *
+ * src/backend/port/wasm_sema.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "pgzero.h"
+#include "storage/ipc.h"
+#include "storage/pg_sema.h"
+#include "storage/shmem.h"
+
+typedef struct PGSemaphoreData
+{
+	int			id;
+} PGSemaphoreData;
+
+static PGSemaphoreData *sharedSemas;	/* array in shared memory */
+static int	numSems;
+static int	maxSems;
+
+Size
+PGSemaphoreShmemSize(int maxSemas)
+{
+	return mul_size(maxSemas, sizeof(PGSemaphoreData));
+}
+
+void
+PGReserveSemaphores(int maxSemas)
+{
+	sharedSemas = (PGSemaphoreData *)
+		ShmemAllocUnlocked(PGSemaphoreShmemSize(maxSemas));
+	numSems = 0;
+	maxSems = maxSemas;
+}
+
+PGSemaphore
+PGSemaphoreCreate(void)
+{
+	PGSemaphore sema;
+
+	/* Can't do this in a backend, because static state is postmaster's */
+	Assert(!IsUnderPostmaster);
+
+	if (numSems >= maxSems)
+		elog(PANIC, "too many semaphores created");
+	sema = &sharedSemas[numSems];
+	sema->id = pgzero_sema_create(1);
+	if (sema->id < 0)
+		elog(PANIC, "could not create semaphore: %m");
+	numSems++;
+	return sema;
+}
+
+void
+PGSemaphoreReset(PGSemaphore sema)
+{
+	if (pgzero_sema_reset(sema->id) < 0)
+		elog(FATAL, "could not reset semaphore: %m");
+}
+
+void
+PGSemaphoreLock(PGSemaphore sema)
+{
+	int			rc;
+
+	/*
+	 * As in posix_sema.c: retry if interrupted by a signal. Handlers only
+	 * set flags and latches, so it is safe to go back to sleep.
+	 */
+	do
+	{
+		rc = pgzero_sema_lock(sema->id);
+	} while (rc < 0 && errno == EINTR);
+
+	if (rc < 0)
+		elog(FATAL, "could not lock semaphore: %m");
+}
+
+void
+PGSemaphoreUnlock(PGSemaphore sema)
+{
+	if (pgzero_sema_unlock(sema->id) < 0)
+		elog(FATAL, "could not unlock semaphore: %m");
+}
+
+bool
+PGSemaphoreTryLock(PGSemaphore sema)
+{
+	if (pgzero_sema_try_lock(sema->id) == 0)
+		return true;
+	if (errno == EAGAIN)
+		return false;
+	elog(FATAL, "could not lock semaphore: %m");
+	return false;
+}
diff --git a/src/backend/port/wasm_shmem.c b/src/backend/port/wasm_shmem.c
new file mode 100644
index 0000000..527b1ea
--- /dev/null
+++ b/src/backend/port/wasm_shmem.c
@@ -0,0 +1,207 @@
+/*-------------------------------------------------------------------------
+ *
+ * wasm_shmem.c
+ *	  Shared memory for the pgzero wasm port.
+ *
+ * Each Postgres process is a separate wasm instance with its own linear
+ * memory. The pgzero host maps a shared segment over a fixed window of that
+ * memory, at the same address in every process, which is exactly what
+ * EXEC_BACKEND needs: children re-attach at the address the postmaster
+ * recorded.
+ *
+ * The window starts at PGZERO_SHM_BASE. Linear memory grows only upwards, so
+ * a process must attach before its heap has grown past the window; the
+ * postmaster and its children attach early in startup, well before that.
+ * Memory between the heap and the window is reserved address space that is
+ * never touched.
+ *
+ * src/backend/port/wasm_shmem.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <unistd.h>
+
+#include "pgzero.h"
+#include "miscadmin.h"
+#include "storage/dsm.h"
+#include "storage/ipc.h"
+#include "storage/pg_shmem.h"
+#include "utils/guc.h"
+#include "utils/guc_hooks.h"
+
+#define WASM_PAGE_SIZE	65536
+#define PGZERO_SHM_BASE	((uintptr_t) 512 * 1024 * 1024)
+
+unsigned long UsedShmemSegID = 0;
+void	   *UsedShmemSegAddr = NULL;
+
+/* End of the window this process has mapped so far (0 if none). */
+static uintptr_t mapped_end = 0;
+
+/*
+ * Map shared segment id, of the given size, at PGZERO_SHM_BASE.
+ */
+static void *
+map_segment(int id, Size size)
+{
+	uintptr_t	end = TYPEALIGN(WASM_PAGE_SIZE, PGZERO_SHM_BASE + size);
+	uintptr_t	cur = (uintptr_t) __builtin_wasm_memory_size(0) * WASM_PAGE_SIZE;
+
+	if (end < PGZERO_SHM_BASE)
+		elog(FATAL, "shared memory segment of %zu bytes is too large", size);
+
+	if (cur > PGZERO_SHM_BASE)
+	{
+		/*
+		 * Only acceptable if the window is already ours, e.g. when the
+		 * postmaster re-creates shared memory after a crash.
+		 */
+		if (mapped_end == 0 || end > mapped_end)
+			elog(FATAL, "cannot map shared memory: the process heap already extends past %p",
+				 (void *) PGZERO_SHM_BASE);
+	}
+	else if (__builtin_wasm_memory_grow(0, (end - cur) / WASM_PAGE_SIZE) < 0)
+		elog(FATAL, "could not reserve %zu bytes of address space for shared memory",
+			 (size_t) (end - cur));
+
+	if (pgzero_shm_attach(id, (void *) PGZERO_SHM_BASE) < 0)
+		elog(FATAL, "could not attach to shared memory segment %d: %m", id);
+
+	if (end > mapped_end)
+		mapped_end = end;
+	return (void *) PGZERO_SHM_BASE;
+}
+
+static void
+shmem_delete(int status, Datum arg)
+{
+	(void) pgzero_shm_remove(DatumGetInt32(arg));
+}
+
+PGShmemHeader *
+PGSharedMemoryCreate(Size size, PGShmemHeader **shim)
+{
+	PGShmemHeader *hdr;
+	int			id;
+
+	Assert(size > MAXALIGN(sizeof(PGShmemHeader)));
+
+	if (huge_pages == HUGE_PAGES_ON)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("huge pages not supported on this platform")));
+
+	if (size > (Size) PG_INT32_MAX)
+		ereport(FATAL,
+				(errmsg("could not create shared memory segment: size %zu is too large", size)));
+
+	id = pgzero_shm_create(size);
+	if (id < 0)
+		ereport(FATAL,
+				(errmsg("could not create shared memory segment: %m"),
+				 errdetail("Failed system call was pgzero_shm_create(size=%zu).", size)));
+	on_shmem_exit(shmem_delete, Int32GetDatum(id));
+
+	hdr = (PGShmemHeader *) map_segment(id, size);
+
+	/*
+	 * Mark the segment as created by this process. The order of
+	 * assignments matters, so that another process can't see the header as
+	 * valid but belonging to an invalid PID.
+	 */
+	hdr->creatorPID = getpid();
+	hdr->magic = PGShmemMagic;
+	hdr->totalsize = size;
+	hdr->freeoffset = MAXALIGN(sizeof(PGShmemHeader));
+	hdr->dsm_control = 0;
+	hdr->device = 0;
+	hdr->inode = 0;
+
+	UsedShmemSegAddr = hdr;
+	UsedShmemSegID = (unsigned long) id;
+
+	SetConfigOption("huge_pages_status", "off",
+					PGC_INTERNAL, PGC_S_DYNAMIC_DEFAULT);
+
+	*shim = hdr;
+	return hdr;
+}
+
+/*
+ * Segments belong to the pgzero host, which frees them when their last
+ * process exits, so there is never a stale segment from a previous
+ * postmaster to worry about.
+ */
+bool
+PGSharedMemoryIsInUse(unsigned long id1, unsigned long id2)
+{
+	return false;
+}
+
+void
+PGSharedMemoryReAttach(void)
+{
+	PGShmemHeader *hdr;
+	int			id = (int) UsedShmemSegID;
+	ssize_t		size;
+
+	Assert(UsedShmemSegAddr != NULL);
+	Assert(IsUnderPostmaster);
+
+	if (UsedShmemSegAddr != (void *) PGZERO_SHM_BASE)
+		elog(FATAL, "unexpected shared memory address %p", UsedShmemSegAddr);
+
+	size = pgzero_shm_size(id);
+	if (size < 0)
+		elog(FATAL, "could not reattach to shared memory (id=%d): %m", id);
+
+	hdr = (PGShmemHeader *) map_segment(id, size);
+	if (hdr->magic != PGShmemMagic)
+		elog(FATAL, "reattached shared memory has bad magic number");
+
+	dsm_set_control_handle(hdr->dsm_control);
+	UsedShmemSegAddr = hdr;
+}
+
+void
+PGSharedMemoryNoReAttach(void)
+{
+	Assert(UsedShmemSegAddr != NULL);
+	Assert(IsUnderPostmaster);
+
+	UsedShmemSegAddr = NULL;
+	UsedShmemSegID = 0;
+}
+
+/*
+ * The mapping stays in place for the life of the process (the host has no
+ * unmap); forgetting it is enough, and a later PGSharedMemoryCreate maps
+ * the new segment over the same window.
+ */
+void
+PGSharedMemoryDetach(void)
+{
+	UsedShmemSegAddr = NULL;
+}
+
+void
+GetHugePageSize(Size *hugepagesize, int *mmap_flags)
+{
+	if (hugepagesize)
+		*hugepagesize = 0;
+	if (mmap_flags)
+		*mmap_flags = 0;
+}
+
+bool
+check_huge_page_size(int *newval, void **extra, GucSource source)
+{
+	if (*newval != 0)
+	{
+		GUC_check_errdetail("\"huge_page_size\" must be 0 on this platform.");
+		return false;
+	}
+	return true;
+}
